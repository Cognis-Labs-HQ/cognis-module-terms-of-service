  <string name="module.terms.of.service.tutorial.title">Rechtsdokumente lesen</string>
  <string name="module.terms.of.service.tutorial.welcome.title">Rechtsdokumente im Überblick</string>
  <string name="module.terms.of.service.tutorial.welcome.body">Öffnen Sie ein Dokument, um seine Bedingungen und verfügbaren Versionen zu lesen.</string>
  <string name="module.terms.of.service.tutorial.document.title">Aktuelles Dokument lesen</string>
  <string name="module.terms.of.service.tutorial.document.body">Lesen Sie das angezeigte Dokument und seine Version.</string>
  <string name="module.terms.of.service.tutorial.navigation.title">Zu einem Abschnitt springen</string>
  <string name="module.terms.of.service.tutorial.navigation.body">Wählen Sie eine Überschrift in diesem Menü, um zu diesem Abschnitt des gerade geöffneten Dokuments zu springen.</string>
  <string name="module.terms.of.service.tutorial.admin.title">Rechtsdokumente verwalten</string>
  <string name="module.terms.of.service.tutorial.admin.documents.title">Rechtsdokument hinzufügen oder aktualisieren</string>
  <string name="module.terms.of.service.tutorial.admin.documents.body">Bereiten Sie hier Nutzungsbedingungen, Datenschutz oder EULA vor. Diese Anleitung verwendet ein Dokument: Hinzufügen beginnt ein unveröffentlichtes Dokument; bei einem vorhandenen bearbeiten Sie den aktuellen Text.</string>
  <string name="module.terms.of.service.tutorial.admin.consent.title">Ein Konto finden</string>
  <string name="module.terms.of.service.tutorial.admin.consent.body">Geben Sie einen Kontonamen ein, um dessen Zustimmung zu finden, oder wählen Sie Weiter, um alle Konten zu durchsehen. Suche und Statusfilter wirken zusammen.</string>
  <string name="module.terms.of.service.tutorial.admin.edit.title">Den Entwurf schreiben</string>
  <string name="module.terms.of.service.tutorial.admin.edit.body">Schreiben oder überarbeiten Sie den Dokumenttext. Verwenden Sie Markdown-Überschriften wie ## Datenschutz und Leerzeilen zwischen Absätzen. Änderungen bleiben vorgemerkt; mit Weiter überspringen Sie die Bearbeitung.</string>
  <string name="module.terms.of.service.tutorial.admin.preview.title">Die Leseransicht prüfen</string>
  <string name="module.terms.of.service.tutorial.admin.preview.body">Klicken Sie auf Vorschau, um Überschriften, Links und Absätze aus Sicht der Leser zu prüfen. Überprüfen Sie die Formulierungen vor der Veröffentlichung.</string>
  <string name="module.terms.of.service.tutorial.admin.publish.title">Den Entwurf unveröffentlicht lassen</string>
  <string name="module.terms.of.service.tutorial.admin.publish.body">Dies ist die Vorschau Ihrer vorgemerkten Änderungen. Nach der Anleitung veröffentlicht Speichern eine neue Version und fordert Benutzer zur Zustimmung auf; Verwerfen stellt den vorherigen Text wieder her. Lassen Sie den Entwurf ungespeichert, um weiterzuarbeiten. Die Zustimmungsübersicht eines neuen Dokuments erscheint nach der ersten Veröffentlichung.</string>
  <string name="module.terms.of.service.tutorial.admin.add.title">Ein neues Dokument beginnen</string>
  <string name="module.terms.of.service.tutorial.admin.add.body">Klicken Sie auf Hinzufügen, um den Editor dieses Dokuments zu öffnen. Erstellen Sie hier einen Entwurf und prüfen Sie anschließend sein Aussehen in der Vorschau.</string>
  <string name="module.terms.of.service.tutorial.admin.compliance.title">Das veröffentlichte Dokument verfolgen</string>
  <string name="module.terms.of.service.tutorial.admin.compliance.body">Die folgende Übersicht gehört zu diesem veröffentlichten Dokument. Sie vergleicht die von jedem Konto akzeptierte Version mit der neuesten veröffentlichten Version. Ihr Entwurf ändert keinen Zustimmungsstatus.</string>
  <string name="module.terms.of.service.tutorial.admin.filter.title">Nach Zustimmungsstatus filtern</string>
  <string name="module.terms.of.service.tutorial.admin.filter.body">Klicken Sie auf Ausstehend für Konten ohne Zustimmung zur neuesten Version, Akzeptiert für bereits zustimmende Konten oder Alle, um den Statusfilter aufzuheben.</string>
  <string name="module.terms.of.service.tutorial.admin.versions.title">Akzeptierte Versionen vergleichen</string>
  <string name="module.terms.of.service.tutorial.admin.versions.body">Jede Zeile zeigt Konto, Zustimmungsstatus, akzeptierte Version und neueste veröffentlichte Version. Nach einer neuen Veröffentlichung reicht eine frühere Zustimmung nicht mehr aus. Ohne passende Zeilen leeren Sie die Suche oder wählen Alle.</string>
</resources>
