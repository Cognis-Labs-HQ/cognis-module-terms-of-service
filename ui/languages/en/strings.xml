  <string name="module.terms.of.service.tutorial.title">Read The Legal Documents</string>
  <string name="module.terms.of.service.tutorial.welcome.title">Legal Document Overview</string>
  <string name="module.terms.of.service.tutorial.welcome.body">Open a document to read its terms and available versions.</string>
  <string name="module.terms.of.service.tutorial.document.title">Read The Current Document</string>
  <string name="module.terms.of.service.tutorial.document.body">Read the displayed document and version.</string>
  <string name="module.terms.of.service.tutorial.navigation.title">Jump To A Section</string>
  <string name="module.terms.of.service.tutorial.navigation.body">Choose a heading in this menu to jump to that section of the document you are reading.</string>
  <string name="module.terms.of.service.tutorial.admin.title">Legal Administration</string>
  <string name="module.terms.of.service.tutorial.admin.documents.title">Add Or Update A Legal Document</string>
  <string name="module.terms.of.service.tutorial.admin.documents.body">Prepare Terms of Service, Privacy Policy or EULA here. This guide uses one document: Add starts an unpublished document; an existing document opens its current text for editing.</string>
  <string name="module.terms.of.service.tutorial.admin.consent.title">Find An Account</string>
  <string name="module.terms.of.service.tutorial.admin.consent.body">Type an account name to find its consent record, or choose Next to browse all accounts. The search combines with the status filter beside it.</string>
  <string name="module.terms.of.service.tutorial.admin.edit.title">Write Your Draft</string>
  <string name="module.terms.of.service.tutorial.admin.edit.body">Type or revise the document text. Use Markdown headings such as ## Privacy and blank lines between paragraphs. Your edits remain staged; choose Next to skip editing.</string>
  <string name="module.terms.of.service.tutorial.admin.preview.title">Check The Reader’s View</string>
  <string name="module.terms.of.service.tutorial.admin.preview.body">Click Preview to check headings, links and paragraphs as readers will see them. Review your wording before deciding whether to publish.</string>
  <string name="module.terms.of.service.tutorial.admin.publish.title">Keep The Draft Unpublished</string>
  <string name="module.terms.of.service.tutorial.admin.publish.body">This is your staged preview. After the guide, Save publishes a new version and asks users to accept it; Discard restores the previous text. Leave it unsaved to keep working. A new document’s compliance tracker appears only after its first publication.</string>
  <string name="module.terms.of.service.tutorial.admin.add.title">Start A New Document</string>
  <string name="module.terms.of.service.tutorial.admin.add.body">Click Add to open this document’s editor. You will prepare a draft here before reviewing its appearance in Preview.</string>
  <string name="module.terms.of.service.tutorial.admin.compliance.title">Track The Published Document</string>
  <string name="module.terms.of.service.tutorial.admin.compliance.body">The tracker below belongs to this published document. It compares each account’s accepted version with the latest published version. Your staged draft does not change anyone’s consent status.</string>
  <string name="module.terms.of.service.tutorial.admin.filter.title">Filter Consent Status</string>
  <string name="module.terms.of.service.tutorial.admin.filter.body">Click Outstanding to see accounts that have not accepted the latest version, Accepted to see those that have, or All to remove the status filter.</string>
  <string name="module.terms.of.service.tutorial.admin.versions.title">Compare Accepted Versions</string>
  <string name="module.terms.of.service.tutorial.admin.versions.body">Each row shows the account, consent status, accepted version and latest published version. A previous acceptance remains outstanding after a new version is published. If no rows match, clear the search or choose All.</string>
